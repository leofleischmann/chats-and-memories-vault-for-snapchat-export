{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "manifest",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "packages": {
    "backend": {
      "path": "backend",
      "release-type": "simple",
      "extra-files": [
        {
          "type": "generic",
          "path": "backend/VERSION"
        }
      ]
    },
    "frontend": {
      "path": "frontend",
      "release-type": "node"
    }
  }
}

